# fabric-core Umgebungsvariablen
# ---> Als Datei ".env" speichern (ohne ".example") im fabric-core-Ordner.
#      docker compose liest .env automatisch. NICHT in Git committen (enthält den Key).

# --- Groq: schnelle Cloud-Inferenz (wie in der Lern-App) ---
GROQ_KEY=gsk_DEIN_KEY_HIER
GROQ_MODEL=qwen/qwen3.8-27b
DEFAULT_BACKEND=groq

# Optional: sensible Anfragen lokal (Ollama) -> dann Modell lokal laden
# DEFAULT_BACKEND=local
